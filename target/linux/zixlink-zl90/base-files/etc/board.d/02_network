. /lib/functions/uci-defaults.sh

board_config_update

json_is_a network object && exit 0

mac=$(/lib/functions/getmac.sh)

ucidef_set_interface "eth0" ifname "eth0" protocol "static" ipaddr "192.168.249.1" netmask "255.255.255.0"

ucidef_set_bridge_device "br-lan"

ucidef_set_interface "lan" device "br-lan" protocol "static" ipaddr "192.168.0.1" netmask "255.255.255.0"

ucidef_set_interface "wan" device "lan0" protocol "dhcp"

board_config_flush

exit 0
