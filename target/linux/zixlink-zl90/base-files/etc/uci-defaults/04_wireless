#!/bin/sh

. /usr/share/libubox/jshn.sh

rm -f /etc/config/wireless
touch /etc/config/wireless

uci -q batch <<EOF
set wireless.radio0=wifi-device
set wireless.radio0.type='mac80211'
set wireless.radio0.path='platform/ffaa0000.mmc/mmc_host/mmc1/mmc1:0001/mmc1:0001:2/cc33xx.2.auto'
set wireless.radio0.band='2g'
set wireless.radio0.channel='6'
set wireless.radio0.country='RU'
set wireless.radio0.txpower='20'
set wireless.radio0.cell_density='0'
set wireless.radio0.disabled='0'
EOF

uci -q batch <<EOF
set wireless.default_radio0=wifi-iface
set wireless.default_radio0.device='radio0'
set wireless.default_radio0.network='lan'
set wireless.default_radio0.mode='ap'
set wireless.default_radio0.ssid='zl90'
set wireless.default_radio0.encryption='psk2'
set wireless.default_radio0.key='1234567890'
EOF

uci commit wireless
/sbin/wifi reload

exit 0
