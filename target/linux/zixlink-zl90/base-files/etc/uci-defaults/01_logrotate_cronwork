#!/bin/sh

if [ -f "/etc/crontabs/root" ]; then
	if [ ! "$(cat '/etc/crontabs/root' | grep '/usr/sbin/logrotate')" ]; then
		echo "*/5 * * * * /usr/sbin/logrotate /etc/logrotate.conf" >> /etc/crontabs/root
	fi
else
	touch /etc/crontabs/root
	chmod +x /etc/crontabs/root
	echo "*/5 * * * * /usr/sbin/logrotate /etc/logrotate.conf" >> /etc/crontabs/root
fi

exit 0
